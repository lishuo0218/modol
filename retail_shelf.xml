<mujoco model="retail_shelf">
  <compiler angle="degree" coordinate="local" />
  <option timestep="0.01" gravity="0 0 -9.81" />

  <asset>
    <material name="mat_shelf" rgba="0.9 0.9 0.9 1" specular="0.3" shininess="0.2" />
    <material name="mat_frame" rgba="0.1 0.1 0.1 1" specular="0.5" shininess="0.8" />
  </asset>

  <default>
    <default class="frame">
      <geom type="box" size="0.02 0.02 1.0" material="mat_frame" />
    </default>
    <default class="shelf">
      <geom type="box" size="1.37 0.2 0.015" material="mat_shelf" condim="3" friction="1 0.005 0.0001" />
    </default>
  </default>

  <worldbody>
    <light pos="2 2 4" dir="0 0 -1" diffuse="0.8 0.8 0.8" />
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.9 0.9 0.9 1" />

    <body name="shelf_unit">
      <geom name="post_FL" class="frame" pos="-1.39 0.22 1.0" />
      <geom name="post_BL" class="frame" pos="-1.39 -0.22 1.0" />
      <geom name="post_FR" class="frame" pos="1.39 0.22 1.0" />
      <geom name="post_BR" class="frame" pos="1.39 -0.22 1.0" />

      <geom name="shelf_0" class="shelf" pos="0 0 0.1" />
      <geom name="shelf_1" class="shelf" pos="0 0 0.4" />
      <geom name="shelf_2" class="shelf" pos="0 0 0.75" />
      <geom name="shelf_3" class="shelf" pos="0 0 1.10" />
      <geom name="shelf_4" class="shelf" pos="0 0 1.45" />
      
      <body name="header" pos="0 0 1.9">
         <geom name="header_body" type="box" size="1.37 0.2 0.1" material="mat_shelf" />
         <geom name="logo_plate" type="box" size="1.2 0.01 0.05" pos="0 0.21 0" rgba="0.1 0.1 0.1 1" />
      </body>
    </body>
  </worldbody>
</mujoco>
