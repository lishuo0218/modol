    <material name="metal_shelf" rgba="0.9 0.9 0.9 1" specular="0.9" shininess="0.8" reflectance="0.5"/>
    <!-- White Plastic: Clean, glossy interior lining -->
    <material name="white_plastic" rgba="0.95 0.95 0.95 1" specular="0.5" shininess="0.6" reflectance="0.1"/>
    
    <!-- Drink Materials -->
    <material name="coke_can" rgba="0.8 0 0 1" specular="0.8" shininess="0.8"/>
    <material name="sprite_bottle" rgba="0 0.6 0 0.8" specular="0.9" shininess="0.9"/>
    <material name="water_bottle" rgba="0.7 0.7 1 0.5" specular="0.9" shininess="0.9"/>
    <material name="orange_juice" rgba="1 0.5 0 1" specular="0.1" shininess="0.1"/>

